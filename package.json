{
  "name": "google-health-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "An MCP server that exposes Google Health API data (steps, sleep, heart rate, SpO2, weight, exercise) to any MCP-compatible AI client via a Cloudflare Worker.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "kv:create": "wrangler kv namespace create HEALTH_TOKENS",
    "token:setup": "node --experimental-strip-types scripts/get-refresh-token.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/mcp": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241004.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "husky": "^9.1.7",
    "open": "^10.1.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9",
    "wrangler": "^3.80.0"
  }
}
